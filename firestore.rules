rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function rolePath() { return /databases/$(database)/documents/authRoles/$(request.auth.uid); }
    function role() { return get(rolePath()).data; }
    function activeRole() { return signedIn() && exists(rolePath()) && role().ativo == true; }
    function isMaster() { return activeRole() && role().papel == 'master'; }
    function isFamilyAdmin() { return activeRole() && role().papel == 'adm_familia'; }
    function isGuestAdmin() { return activeRole() && role().papel == 'adm_convidado'; }
    function isParticipant() { return activeRole() && role().papel == 'participante'; }
    function myGroup() { return activeRole() ? role().grupoId : ''; }
    function myProfile() { return isParticipant() ? role().perfilId : ''; }
    function sameGroup(data) { return activeRole() && data.grupoId == myGroup(); }
    function participantOwn(data) { return isParticipant() && data.grupoId == myGroup() && data.perfilId == myProfile(); }
    function familyOperatorFor(data) { return (isFamilyAdmin() || isGuestAdmin()) && data.grupoId == myGroup(); }
    function guestPermission(key) { return isGuestAdmin() && role().permissoes is map && role().permissoes[key] == true; }

    function taskIdentityUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'grupoId','perfilId','perfilNome','nome','diaSemana','horaSugeridaInicio',
        'horaSugeridaFim','tempoLimite','pontosMaximos','justificativaObrigatoria','tarefaGrupoId'
      ]);
    }

    // Registros criados antes do hardening podem não ter tarefaGrupoId. Permitimos
    // preencher esse campo uma única vez, sem abrir alteração das demais identidades.
    function legacyTaskGroupFillAllowed() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['tarefaGrupoId'])
        || (!('tarefaGrupoId' in resource.data)
            && request.resource.data.tarefaGrupoId is string);
    }

    function historyIdentityUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'grupoId','perfilId','perfilNome','tarefaId','data','nomeTarefa'
      ]) && legacyTaskGroupFillAllowed();
    }

    function finalState(data) {
      return data.status is string
        && (data.status.matches('.*Prazo.*') || data.status.matches('.*Atrasado.*'));
    }

    function finalOutcomeUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'status','horarioInicio','horarioTermino','inicioExecutadoEm','terminoExecutadoEm',
        'pontosGanhos','pontosOriginais','percentualAplicado','percentualOriginal',
        'faixaAtraso','toleranciaConsumidaMin','toleranciaConsumidaSeg','atrasoInicioMin',
        'atrasoFimMin','minutosAlemTolerancia','faixaLeveMinutos','limite75Min','limite50Min',
        'limite75Seg','limite50Seg','iniciouComAtraso','iniciouAposLimiteFinal','dataExecucao'
      ]);
    }

    function participantTaskLifecycleAllowed() {
      return participantOwn(resource.data)
        && participantOwn(request.resource.data)
        && taskIdentityUnchanged()
        && (
          (resource.data.status == 'Pendente' && request.resource.data.status == 'Em andamento')
          || (resource.data.status == 'Em andamento' && request.resource.data.status == 'Em andamento')
          || (resource.data.status == 'Em andamento' && finalState(request.resource.data))
          || (finalState(resource.data) && finalState(request.resource.data) && finalOutcomeUnchanged())
        );
    }

    function participantFinalRecordUpdateAllowed() {
      return participantOwn(resource.data)
        && participantOwn(request.resource.data)
        && historyIdentityUnchanged()
        && finalState(resource.data)
        && finalState(request.resource.data)
        && finalOutcomeUnchanged();
    }

    function participantExecutionUpdateAllowed() {
      return participantOwn(resource.data)
        && participantOwn(request.resource.data)
        && historyIdentityUnchanged()
        && (
          (!finalState(resource.data) && !finalState(request.resource.data))
          || (!finalState(resource.data) && finalState(request.resource.data))
          || (finalState(resource.data) && finalState(request.resource.data) && finalOutcomeUnchanged())
        );
    }

    function alarmIdentityUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['grupoId','perfilId','tarefaId']);
    }

    match /authRoles/{uid} { allow read, write: if false; }

    match /administradores/{id} {
      allow read: if isMaster()
        || (activeRole() && (isFamilyAdmin() || isGuestAdmin()) && resource.data.uid == request.auth.uid);
      allow create, update, delete: if isMaster();
    }

    match /perfis/{id} {
      allow read: if isMaster()
        || ((isFamilyAdmin() || isGuestAdmin()) && resource.data.grupoId == myGroup())
        || participantOwn(resource.data);
      allow create: if isMaster()
        || (isFamilyAdmin() && request.resource.data.grupoId == myGroup())
        || (guestPermission('participantesGerenciar') && request.resource.data.grupoId == myGroup());
      allow update, delete: if isMaster()
        || (isFamilyAdmin() && resource.data.grupoId == myGroup() && request.resource.data.grupoId == myGroup())
        || (guestPermission('participantesGerenciar') && resource.data.grupoId == myGroup() && request.resource.data.grupoId == myGroup());
    }

    match /tarefas/{id} {
      allow read: if isMaster() || familyOperatorFor(resource.data) || participantOwn(resource.data);
      allow create: if isMaster()
        || (isFamilyAdmin() && request.resource.data.grupoId == myGroup())
        || (guestPermission('tarefasGerenciar') && request.resource.data.grupoId == myGroup());
      allow update: if isMaster()
        || (isFamilyAdmin() && resource.data.grupoId == myGroup() && request.resource.data.grupoId == myGroup())
        || (guestPermission('tarefasGerenciar') && resource.data.grupoId == myGroup() && request.resource.data.grupoId == myGroup())
        || participantTaskLifecycleAllowed();
      allow delete: if isMaster()
        || (isFamilyAdmin() && resource.data.grupoId == myGroup())
        || (guestPermission('tarefasGerenciar') && resource.data.grupoId == myGroup());
    }

    match /historico/{id} {
      allow read: if isMaster() || familyOperatorFor(resource.data) || participantOwn(resource.data);
      allow create: if isMaster()
        || ((isFamilyAdmin() || isGuestAdmin()) && request.resource.data.grupoId == myGroup())
        || (participantOwn(request.resource.data) && finalState(request.resource.data));
      allow update: if isMaster()
        || ((isFamilyAdmin() || isGuestAdmin()) && resource.data.grupoId == myGroup() && request.resource.data.grupoId == myGroup())
        || participantFinalRecordUpdateAllowed();
      allow delete: if isMaster() || (isFamilyAdmin() && resource.data.grupoId == myGroup());
    }

    match /execucoes/{id} {
      allow read: if isMaster() || familyOperatorFor(resource.data) || participantOwn(resource.data);
      allow create: if isMaster()
        || ((isFamilyAdmin() || isGuestAdmin()) && request.resource.data.grupoId == myGroup())
        || participantOwn(request.resource.data);
      allow update: if isMaster()
        || ((isFamilyAdmin() || isGuestAdmin()) && resource.data.grupoId == myGroup() && request.resource.data.grupoId == myGroup())
        || participantExecutionUpdateAllowed();
      allow delete: if isMaster() || (isFamilyAdmin() && resource.data.grupoId == myGroup());
    }

    match /recompensas/{id} {
      allow read: if isMaster() || sameGroup(resource.data);
      allow create: if isMaster()
        || (isFamilyAdmin() && request.resource.data.grupoId == myGroup())
        || (guestPermission('recompensasGerenciar') && request.resource.data.grupoId == myGroup());
      allow update, delete: if isMaster()
        || (isFamilyAdmin() && resource.data.grupoId == myGroup() && request.resource.data.grupoId == myGroup())
        || (guestPermission('recompensasGerenciar') && resource.data.grupoId == myGroup() && request.resource.data.grupoId == myGroup());
    }

    match /resgates/{id} {
      allow read: if isMaster()
        || ((isFamilyAdmin() || isGuestAdmin()) && resource.data.grupoId == myGroup())
        || participantOwn(resource.data);
      allow create: if isMaster()
        || ((isFamilyAdmin() || isGuestAdmin()) && request.resource.data.grupoId == myGroup())
        || (participantOwn(request.resource.data) && request.resource.data.status == 'Pendente');
      allow update: if isMaster()
        || (isFamilyAdmin() && resource.data.grupoId == myGroup() && request.resource.data.grupoId == myGroup())
        || (guestPermission('resgatesDecidir') && resource.data.grupoId == myGroup() && request.resource.data.grupoId == myGroup())
        || (participantOwn(resource.data)
            && participantOwn(request.resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pushClientePendente','clienteRetornoVistoEm']));
      allow delete: if isMaster() || (isFamilyAdmin() && resource.data.grupoId == myGroup());
    }

    match /conquistas/{id} {
      allow read: if isMaster()
        || ((isFamilyAdmin() || isGuestAdmin()) && resource.data.grupoId == myGroup())
        || (isParticipant()
            && resource.data.grupoId == myGroup()
            && (resource.data.perfilId == myProfile() || resource.data.perfilId == '__ALL__'));
      allow create, update, delete: if isMaster();
    }

    match /conquistaHistorico/{id} {
      allow read: if isMaster()
        || ((isFamilyAdmin() || isGuestAdmin()) && resource.data.grupoId == myGroup())
        || (isParticipant()
            && resource.data.grupoId == myGroup()
            && (resource.data.perfilId == myProfile() || resource.data.perfilId == '__ALL__'));
      allow create, update, delete: if isMaster();
    }

    match /despertadores/{id} {
      allow read: if isMaster() || familyOperatorFor(resource.data) || participantOwn(resource.data);
      allow create: if isMaster()
        || ((isFamilyAdmin() || isGuestAdmin()) && request.resource.data.grupoId == myGroup())
        || participantOwn(request.resource.data);
      allow update: if isMaster()
        || ((isFamilyAdmin() || isGuestAdmin()) && resource.data.grupoId == myGroup() && request.resource.data.grupoId == myGroup())
        || (participantOwn(resource.data) && participantOwn(request.resource.data) && alarmIdentityUnchanged());
      allow delete: if isMaster()
        || (isFamilyAdmin() && resource.data.grupoId == myGroup())
        || participantOwn(resource.data);
    }

    match /configGrupos/{groupId} {
      allow read: if isMaster()
        || (isFamilyAdmin() && groupId == myGroup())
        || (isGuestAdmin() && groupId == myGroup())
        || (isParticipant() && groupId == myGroup());
      allow create, update: if isMaster() || (isFamilyAdmin() && groupId == myGroup());
      allow delete: if isMaster();
    }

    match /estadoComercial/{groupId} {
      allow read: if isMaster() || (isFamilyAdmin() && groupId == myGroup());
      allow create, update, delete: if isMaster();
    }

    match /appLogs/{id} {
      allow create: if isMaster() || (activeRole() && request.resource.data.grupoId == myGroup());
      allow read, update, delete: if isMaster();
    }

    match /appLogsSecure/{id} {
      allow read: if isMaster();
      allow create, update, delete: if false;
    }

    match /systemMigrations/{id} {
      allow read: if isMaster();
      allow write: if false;
    }

    match /systemMaintenance/{id} {
      allow read: if isMaster();
      allow write: if false;
    }

    match /{document=**} { allow read, write: if isMaster(); }
  }
}
