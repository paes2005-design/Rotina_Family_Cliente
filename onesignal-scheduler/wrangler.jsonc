{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rotina-family-onesignal-scheduler",
  "main": "src/master-rate-limit-production-entry.js",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TECHNICAL_STORE",
        "class_name": "RotinaTechnicalStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "technical-store-v1",
      "new_sqlite_classes": ["RotinaTechnicalStore"]
    }
  ],
  "vars": {
    "FIREBASE_PROJECT_ID": "sistema-de-metas-diarias",
    "ONESIGNAL_APP_ID": "356292b3-a763-4a89-b0e5-21bf54bf0424",
    "CLIENT_APP_URL": "https://paes2005-design.github.io/Rotina_Family_Cliente/",
    "ADMIN_APP_URL": "https://paes2005-design.github.io/Rotina_Family_ADM/",
    "ALARM_TIME_ZONE": "America/Bahia"
  }
}
